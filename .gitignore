# Keep build outputs and local-only material out of version control.
/*
!/.gitignore
!/.clang-format
!/.clang-tidy
!/CMakeLists.txt
!/CMakePresets.json
!/README.md
!/LICENSE
!/.vscode/
!/.vscode/settings.json
!/.vscode/tasks.json
!/.vscode/launch.json
!/.vscode/extensions.json
!/scripts/
!/src/
!/tests/
!/packaging/

/local/
/docs/
/build/
/build-*/

!/src/*.cpp
!/src/*.h
!/src/assets/
!/src/resources/
/src/assets/*
!/src/assets/fonts/
!/src/assets/icons/
!/src/assets/branding/
!/src/assets/*.ico
!/src/assets/*.png
/src/assets/fonts/*
!/src/assets/fonts/*.ttf
!/src/assets/fonts/*-OFL.txt
/src/assets/icons/*
!/src/assets/icons/*.svg
/src/assets/branding/*
!/src/assets/branding/*.svg
/src/resources/*
!/src/resources/*.wlyz
!/src/resources/Manual.md
!/tests/*.cpp
/packaging/*
!/packaging/*.cpp
!/packaging/*.in
!/packaging/*.iss
!/packaging/*.bat
!/packaging/*.md
!/scripts/*.bat
!/scripts/*.py
